# Copy to .env and fill in. .env is gitignored.

# --- Paths
# Standalone: leave the defaults. Sharing with outbound-master: point both at
# that skill's folders, e.g. CONFIG_DIR=../config and STATE_DIR=../state when
# this skill is installed as a subfolder of the outbound project.
CONFIG_DIR=./config
STATE_DIR=./state
RUNS_DIR=./runs

# --- Optional API keys (everything works without them, at lower rate limits)
GITHUB_TOKEN=
REDDIT_USER_AGENT=buyer-signal-scanner/0.1 (contact: you@yourdomain.com)

# --- Safety
# There is no send path in this skill, so there is no DRY_RUN switch to forget.
