# Copy to .env and fill in. .env is gitignored.

# --- Mail sending (Google Workspace service account with domain-wide delegation)
GOOGLE_SERVICE_ACCOUNT_FILE=./config/service-account.json
SEND_AS=you@yourdomain.com
SEND_FROM_NAME=Your Name

# --- Email verification
# Supported: emaillistverify | millionverifier | none
EMAIL_VERIFIER=emaillistverify
EMAIL_VERIFIER_KEY=

# --- Research / enrichment (optional)
# Only needed if providers.research.type in settings.yaml is brave or
# perplexity. The default ('agent') uses your runtime's own web search.
BRAVE_API_KEY=
PERPLEXITY_API_KEY=

# --- Safety
# 1 = render everything, send nothing. Leave this on until you trust a full run.
DRY_RUN=1
DAILY_SEND_CAP=200
SEND_SPACING_MIN_SECONDS=40
SEND_SPACING_MAX_SECONDS=65

# --- Paths (defaults are fine)
STATE_DIR=./state
RUNS_DIR=./runs
CONFIG_DIR=./config
